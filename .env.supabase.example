# ─────────────────────────────────────────────────────────────────────────────
# SECRETS DAS EDGE FUNCTIONS  (NÃO é o .env do frontend)
#
#   cp .env.supabase.example .env.supabase
#   # preencha os valores
#   ./scripts/configurar-supabase.sh
#
# Este arquivo NUNCA vai para o git (já está no .gitignore). São segredos de
# servidor — diferente do .env do frontend, que só tem chave pública.
#
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY e SUPABASE_DB_URL
# NÃO entram aqui: o Supabase injeta sozinho nas functions. Aliás, a plataforma
# recusa qualquer secret cujo nome comece com SUPABASE_.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT_SECRET: NÃO é necessário ─────────────────────────────────────────────
# O login da equipe NÃO usa JWT. Ele passa pelas RPCs create_staff_session /
# create_ceo_session, que gravam um token opaco (uuid) na tabela
# staff_sessions; o app manda esse token no header `x-app-token` e os helpers
# do RLS validam direto no banco. Ver a migration 20260723010000.
#
# A edge function `issue-session-token`, que assinaria um JWT com este secret,
# é código morto — o frontend não a chama. Projetos Supabase novos nem expõem
# mais um JWT Secret HS256 (migraram para chaves assimétricas).
#
# Deixe em branco. Só preencha se um dia reativar o issue-session-token.
JWT_SECRET=

# ── Origem permitida no CORS das functions ───────────────────────────────────
# Domínio do app, com https:// e sem barra final. "*" funciona, mas libera geral.
ALLOWED_ORIGIN=https://menusapp.com.br

# ── Domínio público do cardápio (links compartilhados e prévia no WhatsApp) ──
PUBLIC_DOMAIN=menusapp.com.br

# ── IA (substitui a LOVABLE_API_KEY) ─────────────────────────────────────────
# Usada por digitize-menu, digitize-menu-url e fiscal-ai-suggest.
# Padrão: Google Gemini (https://aistudio.google.com/apikey — tem cota grátis).
AI_API_KEY=
# Opcionais — só se quiser outro provedor/modelo:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL_VISION=gemini-2.5-flash
# AI_MODEL_TEXT=gemini-3-flash-preview

# ── iFood ────────────────────────────────────────────────────────────────────
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# ── Delivery Direto ──────────────────────────────────────────────────────────
DD_CLIENT_ID=
DD_CLIENT_SECRET=

# ── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_SUBSCRIPTIONS_ACCESS_TOKEN=

# ── Nuvem Fiscal (NFC-e) ─────────────────────────────────────────────────────
NUVEM_FISCAL_CLIENT_ID=
NUVEM_FISCAL_CLIENT_SECRET=

# ── QZ Tray (impressão térmica) ──────────────────────────────────────────────
# Cole o PEM inteiro numa linha só, trocando as quebras por \n.
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=
