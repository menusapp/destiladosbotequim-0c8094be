# ─────────────────────────────────────────────────────────────────────────────
# Copie para `.env` e preencha com os dados do SEU projeto Supabase.
#   cp .env.example .env
#
# Onde achar: Supabase → seu projeto → Settings → API
# Estas variáveis vão para dentro do bundle do navegador; use SOMENTE a chave
# publishable/anon aqui. A service_role NUNCA entra em variável VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# Ex.: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"

# Ex.: sb_publishable_xxxxxxxxxxxxxxxxxxxxx  (ou a anon key, se o projeto for antigo)
VITE_SUPABASE_PUBLISHABLE_KEY="SUA_PUBLISHABLE_KEY"

# Só o ref do projeto, sem https:// e sem .supabase.co
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_REF"

# Domínio público onde o cardápio é servido (usado para montar links de
# compartilhamento e QR Code de mesa). Sem https:// e sem barra no fim.
VITE_PUBLIC_DOMAIN="menusapp.com.br"

# Domínios raiz do app, separados por vírgula. Um host IGUAL a um destes não é
# tratado como slug de restaurante; um subdomínio dele é.
VITE_APP_DOMAINS="menusapp.com.br,localhost"
